{
  "name": "code-clash",
  "version": "1.0.0",
  "private": true,
  "description": "Code Clash local development commands",
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "dev": "node scripts/dev.cjs",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "check": "npm --prefix client run lint && npm run build",
    "test": "npm --prefix server run build && node --test tests/*.test.cjs",
    "test:integration": "node scripts/test-integration.cjs",
    "doctor": "node scripts/doctor.cjs",
    "infra:up": "node scripts/infra.cjs up",
    "infra:down": "node scripts/infra.cjs down",
    "db:generate": "npm --prefix server run db:generate",
    "db:push": "npm --prefix server run db:push",
    "db:migrate": "npm --prefix server run db:migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
