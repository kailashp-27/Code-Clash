# Application database (separate from Judge0's database).
DATABASE_URL="postgresql://codeclash:codeclash_local@localhost:5433/codeclash"
PORT=5000
JUDGE0_URL="http://localhost:2358"
# npm run setup replaces this placeholder with a random local secret.
